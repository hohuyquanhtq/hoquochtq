rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Security Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function userProfileExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasAdminCustomClaim() {
      return isSignedIn()
        && request.auth.token.admin == true
        && request.auth.token.role == 'admin';
    }

    function hasActiveAdminMarker() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && (!('uid' in get(/databases/$(database)/documents/admins/$(request.auth.uid)).data)
          || get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.uid == request.auth.uid)
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.email is string
        && request.auth.token.email is string
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.email.lower() == request.auth.token.email.lower()
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin'
        && (get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isActive == true
          || get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true);
    }

    function isAdmin() {
      return hasAdminCustomClaim() || hasActiveAdminMarker();
    }

    function isActiveTeacher() {
      return isSignedIn() && (
        isAdmin() ||
        (userProfileExists() && currentUserData().role == 'teacher' && currentUserData().status == 'active')
      );
    }

    function isActiveStudent() {
      return isSignedIn() && userProfileExists() && currentUserData().role == 'student' && currentUserData().status == 'active';
    }

    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    function isValidExamCode(code) {
      return code is string && code.size() >= 2 && code.size() <= 32 && code.matches('^[A-Z0-9\\-]+$');
    }

    function isValidPublicCode(code) {
      return code is string && code.size() == 6 && (
        code.matches('^[0-9]{6}$') || code.matches('^[A-HJ-NP-Z2-9]{6}$')
      );
    }

    // 3. Entity Validation Blueprints
    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid', 'email', 'role', 'status', 'createdAt', 'updatedAt', 'serverUpdatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'email', 'name', 'role', 'status', 'approval_status', 'pilot_group', 'department',
          'phone', 'school', 'className',
          'approvedBy', 'approvedAt', 'createdAt', 'updatedAt',
          'serverCreatedAt', 'serverUpdatedAt'
        ])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && (!('name' in data) || (data.name is string && data.name.size() >= 1 && data.name.size() <= 150))
        && data.role in ['teacher', 'student', 'admin']
        && data.status in ['pending', 'active', 'locked', 'rejected']
        && (!('approval_status' in data) || data.approval_status in ['pending', 'approved', 'rejected'])
        && (!('pilot_group' in data) || data.pilot_group in ['host_school', 'expanded_pilot', 'standard'])
        && (!('department' in data) || (data.department is string && data.department.size() <= 150))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 32))
        && (!('school' in data) || (data.school is string && data.school.size() <= 200))
        && (!('className' in data) || (data.className is string && data.className.size() <= 80))
        && (!('approvedBy' in data) || (data.approvedBy is string && data.approvedBy.size() <= 128))
        && (!('approvedAt' in data) || (data.approvedAt is string && data.approvedAt.size() <= 64))
        && ((data.createdAt is string && data.createdAt.size() <= 64) || data.createdAt is timestamp)
        && ((data.updatedAt is string && data.updatedAt.size() <= 64) || data.updatedAt is timestamp)
        && (!('serverCreatedAt' in data) || data.serverCreatedAt is timestamp)
        && data.serverUpdatedAt is timestamp;
    }

    function isValidTeacherQuestion(data) {
      return data.keys().hasAll([
          'id', 'ownerId', 'code', 'content', 'type', 'grade', 'topic', 'level',
          'createdAt', 'updatedAt', 'serverCreatedAt', 'serverUpdatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'code', 'content', 'type', 'subjectId', 'subjectName',
          'grade', 'topic', 'chapterId', 'chapterName', 'lessonId', 'lessonName', 'lessonTopic', 'level',
          'folderId', 'options', 'correctOptionId', 'correctOptionIds', 'statements', 'shortAnswerConfig',
          'imageUrl', 'explanation', 'source', 'authorId', 'authorName', 'authorSchool', 'parseStatus', 'parseWarning',
          'teacherVerified', 'isSharedCity', 'isPublicCity', 'cityStatus', 'section', 'sectionTitle', 'createdAt', 'updatedAt',
          'serverCreatedAt', 'serverUpdatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.ownerId)
        && data.code is string && data.code.size() >= 1 && data.code.size() <= 64
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 20000
        && data.type in ['part1_single_choice', 'part1_multiple_choice', 'part2_true_false', 'part3_short_answer']
        && (!('subjectId' in data) || (data.subjectId is string && data.subjectId.size() <= 64))
        && (!('subjectName' in data) || (data.subjectName is string && data.subjectName.size() <= 120))
        && data.grade in ['10', '11', '12', 'chuyen_hsg']
        && data.topic is string && data.topic.size() >= 1 && data.topic.size() <= 64
        && (!('chapterId' in data) || (data.chapterId is string && data.chapterId.size() <= 128))
        && (!('chapterName' in data) || (data.chapterName is string && data.chapterName.size() <= 250))
        && (!('lessonId' in data) || (data.lessonId is string && data.lessonId.size() <= 128))
        && (!('lessonName' in data) || (data.lessonName is string && data.lessonName.size() <= 250))
        && (!('lessonTopic' in data) || (data.lessonTopic is string && data.lessonTopic.size() <= 200))
        && data.level in ['nhan_biet', 'thong_hieu', 'van_dung', 'van_dung_cao']
        && (!('folderId' in data) || (data.folderId is string && data.folderId.size() <= 128))
        && (!('options' in data) || (data.options is list && data.options.size() <= 8))
        && (!('correctOptionId' in data) || (data.correctOptionId is string && data.correctOptionId.size() <= 8))
        && (!('correctOptionIds' in data) || (data.correctOptionIds is list && data.correctOptionIds.size() <= 8 && (data.correctOptionIds.size() == 0 || (data.correctOptionIds[0] is string && data.correctOptionIds[0].size() <= 8))))
        && (!('statements' in data) || (data.statements is list && data.statements.size() <= 8))
        && (!('shortAnswerConfig' in data) || data.shortAnswerConfig is map)
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 1000))
        && (!('explanation' in data) || (data.explanation is string && data.explanation.size() <= 20000))
        && (!('source' in data) || (data.source is string && data.source.size() <= 300))
        && (!('authorId' in data) || (data.authorId is string && data.authorId.size() <= 128))
        && (!('authorName' in data) || (data.authorName is string && data.authorName.size() <= 150))
        && (!('authorSchool' in data) || (data.authorSchool is string && data.authorSchool.size() <= 200))
        && (!('parseStatus' in data) || data.parseStatus in ['verified', 'needs_review', 'error'])
        && (!('parseWarning' in data) || (data.parseWarning is string && data.parseWarning.size() <= 500))
        && (!('teacherVerified' in data) || data.teacherVerified is bool)
        && (!('isSharedCity' in data) || data.isSharedCity is bool)
        && (!('isPublicCity' in data) || data.isPublicCity is bool)
        && (!('cityStatus' in data) || data.cityStatus in ['pending', 'approved', 'rejected'])
        && (!('section' in data) || (data.section is string && data.section.size() <= 64))
        && (!('sectionTitle' in data) || (data.sectionTitle is string && data.sectionTitle.size() <= 300))
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && data.serverCreatedAt is timestamp
        && data.serverUpdatedAt is timestamp;
    }

    function isValidTeacherSubject(data) {
      return data.keys().hasAll([
          'id', 'ownerId', 'name', 'createdAt', 'updatedAt', 'serverCreatedAt', 'serverUpdatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'authorId', 'name', 'shortName', 'codePrefix',
          'isDefault', 'order', 'createdAt', 'updatedAt', 'serverCreatedAt', 'serverUpdatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.ownerId)
        && (!('authorId' in data) || (data.authorId is string && data.authorId.size() <= 128))
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && (!('shortName' in data) || (data.shortName is string && data.shortName.size() <= 40))
        && (!('codePrefix' in data) || (data.codePrefix is string && data.codePrefix.size() <= 16))
        && (!('isDefault' in data) || data.isDefault is bool)
        && (!('order' in data) || (data.order is number && data.order >= 0 && data.order <= 10000))
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && data.serverCreatedAt is timestamp
        && data.serverUpdatedAt is timestamp;
    }

    function isValidTeacherFolder(data) {
      return data.keys().hasAll([
          'id', 'ownerId', 'name', 'createdAt', 'updatedAt', 'serverCreatedAt', 'serverUpdatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'folderId', 'ownerId', 'name', 'parentId', 'description', 'grade', 'color',
          'authorId', 'createdBy', 'updatedBy', 'itemCount', 'createdAt', 'updatedAt',
          'serverCreatedAt', 'serverUpdatedAt'
        ])
        && isValidId(data.id)
        && (!('folderId' in data) || isValidId(data.folderId))
        && isValidId(data.ownerId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 150
        && (!('parentId' in data) || data.parentId == null || (data.parentId is string && data.parentId.size() <= 128))
        && (!('description' in data) || (data.description is string && data.description.size() <= 500))
        && (!('grade' in data) || data.grade in ['10', '11', '12', 'chuyen_hsg'])
        && (!('color' in data) || (data.color is string && data.color.size() <= 32))
        && (!('authorId' in data) || (data.authorId is string && data.authorId.size() <= 128))
        && (!('createdBy' in data) || (data.createdBy is string && data.createdBy.size() <= 128))
        && (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 128))
        && (!('itemCount' in data) || (data.itemCount is number && data.itemCount >= 0 && data.itemCount <= 100000))
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && data.serverCreatedAt is timestamp
        && data.serverUpdatedAt is timestamp;
    }

    function isValidClassroom(data) {
      return data.keys().hasAll([
          'id', 'ownerId', 'teacherName', 'className', 'classCode',
          'assignedExamCodes', 'isActive', 'createdAt', 'updatedAt',
          'serverCreatedAt', 'serverUpdatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'teacherName', 'school', 'className', 'classCode',
          'description', 'assignedExamCodes', 'isActive', 'createdAt', 'updatedAt',
          'serverCreatedAt', 'serverUpdatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.ownerId)
        && data.teacherName is string && data.teacherName.size() >= 1 && data.teacherName.size() <= 150
        && (!('school' in data) || (data.school is string && data.school.size() <= 200))
        && data.className is string && data.className.size() >= 1 && data.className.size() <= 120
        && isValidExamCode(data.classCode)
        && (!('description' in data) || (data.description is string && data.description.size() <= 500))
        && data.assignedExamCodes is list && data.assignedExamCodes.size() <= 100
        && data.isActive is bool
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && data.serverCreatedAt is timestamp
        && data.serverUpdatedAt is timestamp;
    }

    function isValidClassJoinLookup(data) {
      return data.keys().hasAll([
          'classCode', 'classId', 'className', 'teacherId', 'teacherName',
          'assignedExamCodes', 'isActive', 'updatedAt', 'serverUpdatedAt'
        ])
        && data.keys().hasOnly([
          'classCode', 'classId', 'className', 'teacherId', 'teacherName',
          'school', 'assignedExamCodes', 'isActive', 'updatedAt', 'serverUpdatedAt'
        ])
        && isValidExamCode(data.classCode)
        && isValidId(data.classId)
        && data.className is string && data.className.size() >= 1 && data.className.size() <= 120
        && isValidId(data.teacherId)
        && data.teacherName is string && data.teacherName.size() >= 1 && data.teacherName.size() <= 150
        && (!('school' in data) || (data.school is string && data.school.size() <= 200))
        && data.assignedExamCodes is list && data.assignedExamCodes.size() <= 100
        && data.isActive is bool
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && data.serverUpdatedAt is timestamp;
    }

    function isValidClassEnrollment(data) {
      return data.keys().hasAll([
          'id', 'classId', 'classCode', 'className', 'teacherId', 'teacherName',
          'studentId', 'studentName', 'studentEmail', 'joinedAt', 'serverJoinedAt'
        ])
        && data.keys().hasOnly([
          'id', 'classId', 'classCode', 'className', 'teacherId', 'teacherName',
          'studentId', 'studentName', 'studentEmail', 'studentClassName',
          'joinedAt', 'serverJoinedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.classId)
        && isValidExamCode(data.classCode)
        && data.className is string && data.className.size() >= 1 && data.className.size() <= 120
        && isValidId(data.teacherId)
        && data.teacherName is string && data.teacherName.size() >= 1 && data.teacherName.size() <= 150
        && isValidId(data.studentId)
        && data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 150
        && data.studentEmail is string && data.studentEmail.size() >= 3 && data.studentEmail.size() <= 200
        && (!('studentClassName' in data) || (data.studentClassName is string && data.studentClassName.size() <= 80))
        && data.joinedAt is string && data.joinedAt.size() <= 64
        && data.serverJoinedAt is timestamp;
    }

    function isValidUploadRecord(data) {
      return data.keys().hasAll([
          'id', 'ownerId', 'fileName', 'fileType', 'examTitle',
          'totalQuestions', 'grade', 'createdAt', 'serverCreatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'fileName', 'fileType', 'examTitle',
          'totalQuestions', 'grade', 'createdAt', 'serverCreatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.ownerId)
        && data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 255
        && data.fileType in ['docx', 'pdf', 'text']
        && data.examTitle is string && data.examTitle.size() >= 1 && data.examTitle.size() <= 300
        && data.totalQuestions is number && data.totalQuestions >= 0 && data.totalQuestions <= 200
        && data.grade in ['10', '11', '12', 'chuyen_hsg']
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.serverCreatedAt is timestamp;
    }

    function isValidExamMaster(data) {
      return data.keys().hasAll([
          'id', 'code', 'title', 'grade', 'durationMinutes', 'totalQuestions',
          'totalScore', 'questions', 'rules', 'isPublished', 'ownerId',
          'authorName', 'createdAt', 'updatedAt', 'serverCreatedAt', 'serverUpdatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'examId', 'code', 'publicCode', 'title', 'description', 'subjectId', 'subjectName',
          'grade', 'topic', 'folderId',
          'durationMinutes', 'totalQuestions', 'totalScore', 'questions', 'rules',
          'shuffleQuestions', 'shuffleOptions', 'isPublished', 'openAt', 'closeAt',
          'maxAttempts', 'showScoreAfterSubmit', 'showAnswersAfterSubmit',
          'showSolutionsAfterSubmit', 'allowReviewLater', 'assignedClassCodes',
          'requiresPassword', 'passwordUpdatedAt', 'allowAnswerReview',
          'answerReviewMinScore', 'answerReviewEnabledAt',
          'ownerId', 'authorId', 'createdBy', 'updatedBy', 'authorName',
          'authorSchool', 'authorDepartment', 'share_status', 'shareRequestedAt',
          'cityApprovedBy', 'cityApprovedAt', 'cityReviewNote', 'clonedFromExamId', 'cloneCount',
          'createdAt', 'updatedAt', 'serverCreatedAt', 'serverUpdatedAt'
        ])
        && isValidId(data.id)
        && (!('examId' in data) || isValidId(data.examId))
        && isValidExamCode(data.code)
        && (!('publicCode' in data) || isValidPublicCode(data.publicCode))
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 300
        && (!('description' in data) || (data.description is string && data.description.size() <= 1000))
        && (!('subjectId' in data) || (data.subjectId is string && data.subjectId.size() <= 64))
        && (!('subjectName' in data) || (data.subjectName is string && data.subjectName.size() <= 120))
        && data.grade in ['10', '11', '12', 'chuyen_hsg']
        && (!('topic' in data) || (data.topic is string && data.topic.size() <= 64))
        && (!('folderId' in data) || data.folderId == null || (data.folderId is string && data.folderId.size() <= 128))
        && data.durationMinutes is number && data.durationMinutes >= 1 && data.durationMinutes <= 600
        && data.totalQuestions is number && data.totalQuestions >= 0 && data.totalQuestions <= 200
        && data.totalScore is number && data.totalScore >= 0 && data.totalScore <= 100
        && data.questions is list && data.questions.size() <= 200
        && (data.questions.size() == 0 || data.questions[0] is map)
        && data.rules is map
        && (!('shuffleQuestions' in data) || data.shuffleQuestions is bool)
        && (!('shuffleOptions' in data) || data.shuffleOptions is bool)
        && data.isPublished is bool
        && (!('openAt' in data) || (data.openAt is string && data.openAt.size() <= 64))
        && (!('closeAt' in data) || (data.closeAt is string && data.closeAt.size() <= 64))
        && (!('maxAttempts' in data) || (data.maxAttempts is number && data.maxAttempts >= 0 && data.maxAttempts <= 1000))
        && (!('showScoreAfterSubmit' in data) || data.showScoreAfterSubmit is bool)
        && (!('showAnswersAfterSubmit' in data) || data.showAnswersAfterSubmit is bool)
        && (!('showSolutionsAfterSubmit' in data) || data.showSolutionsAfterSubmit is bool)
        && (!('allowReviewLater' in data) || data.allowReviewLater is bool)
        && (!('assignedClassCodes' in data) || (data.assignedClassCodes is list && data.assignedClassCodes.size() <= 100))
        && (!('requiresPassword' in data) || data.requiresPassword is bool)
        && (!('passwordUpdatedAt' in data) || data.passwordUpdatedAt == null || (data.passwordUpdatedAt is string && data.passwordUpdatedAt.size() <= 64))
        && (!('allowAnswerReview' in data) || data.allowAnswerReview is bool)
        && (!('answerReviewMinScore' in data) || (data.answerReviewMinScore is number && data.answerReviewMinScore >= 0 && data.answerReviewMinScore <= 10))
        && (!('answerReviewEnabledAt' in data) || data.answerReviewEnabledAt == null || (data.answerReviewEnabledAt is string && data.answerReviewEnabledAt.size() <= 64))
        && isValidId(data.ownerId)
        && (!('authorId' in data) || (data.authorId is string && data.authorId.size() <= 128))
        && (!('createdBy' in data) || (data.createdBy is string && data.createdBy.size() <= 128))
        && (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 128))
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 150
        && (!('authorSchool' in data) || (data.authorSchool is string && data.authorSchool.size() <= 200))
        && (!('authorDepartment' in data) || (data.authorDepartment is string && data.authorDepartment.size() <= 150))
        && (!('share_status' in data) || data.share_status in ['private', 'pending_review', 'city_public'])
        && (!('shareRequestedAt' in data) || data.shareRequestedAt == null || (data.shareRequestedAt is string && data.shareRequestedAt.size() <= 64))
        && (!('cityApprovedBy' in data) || data.cityApprovedBy == null || (data.cityApprovedBy is string && data.cityApprovedBy.size() <= 128))
        && (!('cityApprovedAt' in data) || data.cityApprovedAt == null || (data.cityApprovedAt is string && data.cityApprovedAt.size() <= 64))
        && (!('cityReviewNote' in data) || data.cityReviewNote == null || (data.cityReviewNote is string && data.cityReviewNote.size() <= 500))
        && (!('clonedFromExamId' in data) || data.clonedFromExamId == null || (data.clonedFromExamId is string && data.clonedFromExamId.size() <= 128))
        && (!('cloneCount' in data) || (data.cloneCount is number && data.cloneCount >= 0 && data.cloneCount <= 100000))
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && data.serverCreatedAt is timestamp
        && data.serverUpdatedAt is timestamp;
    }

    function isValidExamStatus(data) {
      return data.keys().hasAll([
          'examCode', 'examId', 'title', 'grade', 'durationMinutes',
          'totalQuestions', 'totalScore', 'isPublished', 'authorName',
          'ownerId', 'updatedAt', 'serverUpdatedAt'
        ])
        && data.keys().hasOnly([
          'examCode', 'publicCode', 'examId', 'title', 'grade', 'durationMinutes',
          'totalQuestions', 'totalScore', 'isPublished', 'openAt', 'closeAt',
          'requiresPassword', 'allowAnswerReview', 'answerReviewMinScore',
          'answerReviewEnabledAt', 'showScoreAfterSubmit', 'showSolutionsAfterSubmit',
          'maxAttempts', 'authorName', 'ownerId', 'updatedAt', 'serverUpdatedAt'
        ])
        && isValidExamCode(data.examCode)
        && (!('publicCode' in data) || isValidPublicCode(data.publicCode))
        && isValidId(data.examId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 300
        && data.grade in ['10', '11', '12', 'chuyen_hsg']
        && data.durationMinutes is number && data.durationMinutes >= 1 && data.durationMinutes <= 600
        && data.totalQuestions is number && data.totalQuestions >= 0 && data.totalQuestions <= 200
        && data.totalScore is number && data.totalScore >= 0 && data.totalScore <= 100
        && data.isPublished is bool
        && (!('openAt' in data) || (data.openAt is string && data.openAt.size() <= 64))
        && (!('closeAt' in data) || (data.closeAt is string && data.closeAt.size() <= 64))
        && (!('requiresPassword' in data) || data.requiresPassword is bool)
        && (!('allowAnswerReview' in data) || data.allowAnswerReview is bool)
        && (!('answerReviewMinScore' in data) || (data.answerReviewMinScore is number && data.answerReviewMinScore >= 0 && data.answerReviewMinScore <= 10))
        && (!('answerReviewEnabledAt' in data) || data.answerReviewEnabledAt == null || (data.answerReviewEnabledAt is string && data.answerReviewEnabledAt.size() <= 64))
        && (!('showScoreAfterSubmit' in data) || data.showScoreAfterSubmit is bool)
        && (!('showSolutionsAfterSubmit' in data) || data.showSolutionsAfterSubmit is bool)
        && (!('maxAttempts' in data) || (data.maxAttempts is number && data.maxAttempts >= 0 && data.maxAttempts <= 1000))
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 150
        && isValidId(data.ownerId)
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && data.serverUpdatedAt is timestamp;
    }

    function isValidPublicExam(data) {
      return data.keys().hasAll([
          'id', 'code', 'title', 'grade', 'durationMinutes', 'totalQuestions',
          'totalScore', 'questions', 'rules', 'isPublished',
          'showScoreAfterSubmit', 'showAnswersAfterSubmit', 'showSolutionsAfterSubmit',
          'authorName', 'ownerId', 'updatedAt', 'serverUpdatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'code', 'publicCode', 'title', 'grade', 'topic', 'durationMinutes', 'totalQuestions',
          'totalScore', 'questions', 'rules', 'shuffleQuestions', 'shuffleOptions',
          'isPublished', 'openAt', 'closeAt', 'maxAttempts', 'showScoreAfterSubmit',
          'showAnswersAfterSubmit', 'showSolutionsAfterSubmit', 'allowReviewLater',
          'assignedClassCodes', 'requiresPassword', 'passwordUpdatedAt',
          'allowAnswerReview', 'answerReviewMinScore', 'answerReviewEnabledAt',
          'authorName', 'ownerId', 'createdAt', 'updatedAt', 'serverUpdatedAt'
        ])
        && isValidId(data.id)
        && isValidExamCode(data.code)
        && (!('publicCode' in data) || isValidPublicCode(data.publicCode))
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 300
        && data.grade in ['10', '11', '12', 'chuyen_hsg']
        && (!('topic' in data) || (data.topic is string && data.topic.size() <= 64))
        && data.durationMinutes is number && data.durationMinutes >= 1 && data.durationMinutes <= 600
        && data.totalQuestions is number && data.totalQuestions >= 0 && data.totalQuestions <= 200
        && data.totalScore is number && data.totalScore >= 0 && data.totalScore <= 100
        && data.questions is list && data.questions.size() <= 200
        && (data.questions.size() == 0 || data.questions[0] is map)
        && data.rules is map
        && (!('shuffleQuestions' in data) || data.shuffleQuestions is bool)
        && (!('shuffleOptions' in data) || data.shuffleOptions is bool)
        && data.isPublished is bool
        && (!('openAt' in data) || (data.openAt is string && data.openAt.size() <= 64))
        && (!('closeAt' in data) || (data.closeAt is string && data.closeAt.size() <= 64))
        && (!('maxAttempts' in data) || (data.maxAttempts is number && data.maxAttempts >= 0 && data.maxAttempts <= 1000))
        && data.showScoreAfterSubmit is bool
        && data.showAnswersAfterSubmit is bool
        && data.showSolutionsAfterSubmit is bool
        && (!('allowReviewLater' in data) || data.allowReviewLater is bool)
        && (!('assignedClassCodes' in data) || (data.assignedClassCodes is list && data.assignedClassCodes.size() <= 100))
        && (!('requiresPassword' in data) || data.requiresPassword is bool)
        && (!('passwordUpdatedAt' in data) || data.passwordUpdatedAt == null || (data.passwordUpdatedAt is string && data.passwordUpdatedAt.size() <= 64))
        && (!('allowAnswerReview' in data) || data.allowAnswerReview is bool)
        && (!('answerReviewMinScore' in data) || (data.answerReviewMinScore is number && data.answerReviewMinScore >= 0 && data.answerReviewMinScore <= 10))
        && (!('answerReviewEnabledAt' in data) || data.answerReviewEnabledAt == null || (data.answerReviewEnabledAt is string && data.answerReviewEnabledAt.size() <= 64))
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 150
        && isValidId(data.ownerId)
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64))
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && data.serverUpdatedAt is timestamp;
    }

    function isValidExamAnswerKey(data) {
      return data.keys().hasAll([
          'examCode', 'examId', 'ownerId', 'isPublished',
          'showAnswersAfterSubmit', 'showSolutionsAfterSubmit', 'answerMap',
          'updatedAt', 'serverUpdatedAt'
        ])
        && data.keys().hasOnly([
          'examCode', 'examId', 'ownerId', 'isPublished',
          'showAnswersAfterSubmit', 'showSolutionsAfterSubmit',
          'allowAnswerReview', 'answerReviewMinScore', 'answerReviewEnabledAt',
          'answerMap', 'updatedAt', 'serverUpdatedAt'
        ])
        && isValidExamCode(data.examCode)
        && isValidId(data.examId)
        && isValidId(data.ownerId)
        && data.isPublished is bool
        && data.showAnswersAfterSubmit is bool
        && data.showSolutionsAfterSubmit is bool
        && (!('allowAnswerReview' in data) || data.allowAnswerReview is bool)
        && (!('answerReviewMinScore' in data) || (data.answerReviewMinScore is number && data.answerReviewMinScore >= 0 && data.answerReviewMinScore <= 10))
        && (!('answerReviewEnabledAt' in data) || data.answerReviewEnabledAt == null || (data.answerReviewEnabledAt is string && data.answerReviewEnabledAt.size() <= 64))
        && data.answerMap is map
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && data.serverUpdatedAt is timestamp;
    }

    function isValidExamSecret(data) {
      return data.keys().hasAll([
          'examCode', 'examId', 'ownerId', 'requiresPassword',
          'allowAnswerReview', 'answerReviewMinScore', 'updatedAt', 'serverUpdatedAt'
        ])
        && data.keys().hasOnly([
          'examCode', 'examId', 'ownerId', 'requiresPassword', 'passwordHash',
          'passwordUpdatedAt', 'allowAnswerReview', 'answerReviewMinScore',
          'answerReviewEnabledAt', 'showScoreAfterSubmit', 'showAnswersAfterSubmit',
          'showSolutionsAfterSubmit', 'isPublished', 'openAt', 'closeAt',
          'maxAttempts', 'rules', 'questions', 'answerMap',
          'updatedAt', 'serverUpdatedAt'
        ])
        && isValidExamCode(data.examCode)
        && isValidId(data.examId)
        && isValidId(data.ownerId)
        && data.requiresPassword is bool
        && (!('passwordHash' in data) || data.passwordHash == null || (data.passwordHash is string && data.passwordHash.size() <= 512))
        && (!('passwordUpdatedAt' in data) || data.passwordUpdatedAt == null || (data.passwordUpdatedAt is string && data.passwordUpdatedAt.size() <= 64))
        && data.allowAnswerReview is bool
        && data.answerReviewMinScore is number && data.answerReviewMinScore >= 0 && data.answerReviewMinScore <= 10
        && (!('answerReviewEnabledAt' in data) || data.answerReviewEnabledAt == null || (data.answerReviewEnabledAt is string && data.answerReviewEnabledAt.size() <= 64))
        && (!('showScoreAfterSubmit' in data) || data.showScoreAfterSubmit is bool)
        && (!('showAnswersAfterSubmit' in data) || data.showAnswersAfterSubmit is bool)
        && (!('showSolutionsAfterSubmit' in data) || data.showSolutionsAfterSubmit is bool)
        && (!('isPublished' in data) || data.isPublished is bool)
        && (!('openAt' in data) || data.openAt == null || (data.openAt is string && data.openAt.size() <= 64))
        && (!('closeAt' in data) || data.closeAt == null || (data.closeAt is string && data.closeAt.size() <= 64))
        && (!('maxAttempts' in data) || (data.maxAttempts is number && data.maxAttempts >= 0 && data.maxAttempts <= 1000))
        && (!('rules' in data) || data.rules is map)
        && (!('questions' in data) || data.questions is list)
        && (!('answerMap' in data) || data.answerMap is map)
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && (data.serverUpdatedAt is timestamp || data.serverUpdatedAt is string);
    }

    function isValidSubmission(data) {
      return data.keys().hasAll([
          'id', 'examId', 'examTitle', 'examCode', 'ownerId', 'studentId',
          'studentName', 'studentClass', 'startedAt', 'submittedAt',
          'durationSeconds', 'answers', 'part1Score', 'part2Score', 'part3Score',
          'totalScore', 'maxPossibleScore', 'correctQuestionsCount', 'status', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'attemptId', 'examId', 'examTitle', 'examCode', 'publicCode', 'variantCode', 'ownerId',
          'studentId', 'studentName', 'studentClass', 'startedAt', 'submittedAt',
          'durationSeconds', 'answers', 'part1Score', 'part2Score', 'part3Score',
          'totalScore', 'maxPossibleScore', 'totalQuestions', 'correctQuestionsCount',
          'wrongQuestionsCount', 'unansweredQuestionsCount',
          'tabSwitchesCount', 'status', 'gradedByServer', 'serverGradeDigest',
          'serverGradedAt', 'examVersionUpdatedAt', 'hasSubmissionSnapshot', 'createdAt'
        ])
        && isValidId(data.id)
        && (!('attemptId' in data) || (data.attemptId is string && data.attemptId.size() <= 128))
        && isValidId(data.examId)
        && data.examTitle is string && data.examTitle.size() >= 1 && data.examTitle.size() <= 300
        && isValidExamCode(data.examCode)
        && (!('publicCode' in data) || isValidPublicCode(data.publicCode))
        && (!('variantCode' in data) || (data.variantCode is string && data.variantCode.size() <= 32))
        && isValidId(data.ownerId)
        && data.studentId is string && data.studentId.size() >= 1 && data.studentId.size() <= 128
        && data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 120
        && data.studentClass is string && data.studentClass.size() >= 1 && data.studentClass.size() <= 80
        && data.startedAt is string && data.startedAt.size() <= 64
        && data.submittedAt is string && data.submittedAt.size() <= 64
        && data.durationSeconds is number && data.durationSeconds >= 0 && data.durationSeconds <= 86400
        && data.answers is map
        && data.part1Score is number && data.part1Score >= 0 && data.part1Score <= 100
        && data.part2Score is number && data.part2Score >= 0 && data.part2Score <= 100
        && data.part3Score is number && data.part3Score >= 0 && data.part3Score <= 100
        && data.totalScore is number && data.totalScore >= 0 && data.totalScore <= 100
        && data.maxPossibleScore is number && data.maxPossibleScore >= 0 && data.maxPossibleScore <= 100
        && (!('totalQuestions' in data) || (data.totalQuestions is number && data.totalQuestions >= 0 && data.totalQuestions <= 200))
        && data.correctQuestionsCount is number && data.correctQuestionsCount >= 0 && data.correctQuestionsCount <= 200
        && (!('wrongQuestionsCount' in data) || (data.wrongQuestionsCount is number && data.wrongQuestionsCount >= 0 && data.wrongQuestionsCount <= 200))
        && (!('unansweredQuestionsCount' in data) || (data.unansweredQuestionsCount is number && data.unansweredQuestionsCount >= 0 && data.unansweredQuestionsCount <= 200))
        && (!('tabSwitchesCount' in data) || (data.tabSwitchesCount is number && data.tabSwitchesCount >= 0 && data.tabSwitchesCount <= 10000))
        && data.status in ['completed', 'in_progress', 'timed_out']
        && (!('gradedByServer' in data) || data.gradedByServer is bool)
        && (!('serverGradeDigest' in data) || (data.serverGradeDigest is string && data.serverGradeDigest.size() <= 128))
        && (!('serverGradedAt' in data) || (data.serverGradedAt is string && data.serverGradedAt.size() <= 64))
        && (!('examVersionUpdatedAt' in data) || (data.examVersionUpdatedAt is string && data.examVersionUpdatedAt.size() <= 64))
        && (!('hasSubmissionSnapshot' in data) || data.hasSubmissionSnapshot is bool)
        && (data.createdAt is timestamp || data.createdAt is string);
    }

    function isValidSubmissionSnapshot(data) {
      return data.keys().hasAll([
          'id', 'submissionId', 'examId', 'examCode', 'examTitle', 'ownerId',
          'studentId', 'studentName', 'studentClass', 'startedAt', 'submittedAt',
          'durationSeconds', 'part1Score', 'part2Score', 'part3Score', 'totalScore',
          'maxPossibleScore', 'totalQuestions', 'correctQuestionsCount',
          'wrongQuestionsCount', 'unansweredQuestionsCount', 'status', 'capturedAt',
          'questionResults'
        ])
        && data.keys().hasOnly([
          'id', 'submissionId', 'attemptId', 'examId', 'examCode', 'publicCode', 'variantCode',
          'examTitle', 'examVersionUpdatedAt', 'ownerId', 'studentId', 'studentName', 'studentClass',
          'startedAt', 'submittedAt', 'durationSeconds', 'part1Score', 'part2Score', 'part3Score',
          'totalScore', 'maxPossibleScore', 'totalQuestions', 'correctQuestionsCount',
          'wrongQuestionsCount', 'unansweredQuestionsCount', 'tabSwitchesCount', 'status',
          'gradedByServer', 'isLegacyReconstructed', 'capturedAt', 'questionResults', 'serverCapturedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.submissionId)
        && (!('attemptId' in data) || (data.attemptId is string && data.attemptId.size() <= 128))
        && isValidId(data.examId)
        && isValidExamCode(data.examCode)
        && (!('publicCode' in data) || isValidPublicCode(data.publicCode))
        && (!('variantCode' in data) || (data.variantCode is string && data.variantCode.size() <= 32))
        && data.examTitle is string && data.examTitle.size() >= 1 && data.examTitle.size() <= 300
        && (!('examVersionUpdatedAt' in data) || (data.examVersionUpdatedAt is string && data.examVersionUpdatedAt.size() <= 64))
        && isValidId(data.ownerId)
        && data.studentId is string && data.studentId.size() >= 1 && data.studentId.size() <= 128
        && data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 120
        && data.studentClass is string && data.studentClass.size() >= 1 && data.studentClass.size() <= 80
        && data.startedAt is string && data.startedAt.size() <= 64
        && data.submittedAt is string && data.submittedAt.size() <= 64
        && data.durationSeconds is number && data.durationSeconds >= 0 && data.durationSeconds <= 86400
        && data.part1Score is number && data.part1Score >= 0 && data.part1Score <= 100
        && data.part2Score is number && data.part2Score >= 0 && data.part2Score <= 100
        && data.part3Score is number && data.part3Score >= 0 && data.part3Score <= 100
        && data.totalScore is number && data.totalScore >= 0 && data.totalScore <= 100
        && data.maxPossibleScore is number && data.maxPossibleScore >= 0 && data.maxPossibleScore <= 100
        && data.totalQuestions is number && data.totalQuestions >= 0 && data.totalQuestions <= 200
        && data.correctQuestionsCount is number && data.correctQuestionsCount >= 0 && data.correctQuestionsCount <= 200
        && data.wrongQuestionsCount is number && data.wrongQuestionsCount >= 0 && data.wrongQuestionsCount <= 200
        && data.unansweredQuestionsCount is number && data.unansweredQuestionsCount >= 0 && data.unansweredQuestionsCount <= 200
        && (!('tabSwitchesCount' in data) || (data.tabSwitchesCount is number && data.tabSwitchesCount >= 0 && data.tabSwitchesCount <= 10000))
        && data.status in ['completed', 'in_progress', 'timed_out']
        && (!('gradedByServer' in data) || data.gradedByServer is bool)
        && (!('isLegacyReconstructed' in data) || data.isLegacyReconstructed is bool)
        && data.capturedAt is string && data.capturedAt.size() <= 64
        && data.questionResults is list && data.questionResults.size() <= 200
        && (data.questionResults.size() == 0 || data.questionResults[0] is map)
        && (!('serverCapturedAt' in data) || (data.serverCapturedAt is timestamp || data.serverCapturedAt is string));
    }

    // 4. Collection Rules
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == userId
        && (!('email' in request.auth.token) || (request.auth.token.email is string && incoming().email.lower() == request.auth.token.email.lower()))
        && incoming().serverCreatedAt == request.time
        && incoming().serverUpdatedAt == request.time
        && (
          (incoming().role == 'student'
            && incoming().status == 'active'
            && !('approval_status' in incoming())
            && !('pilot_group' in incoming())) ||
          (incoming().role == 'teacher'
            && incoming().status == 'pending'
            && (!('approval_status' in incoming()) || incoming().approval_status == 'pending')
            && (!('pilot_group' in incoming()) || incoming().pilot_group == 'standard')) ||
          (isAdmin() && incoming().role == 'admin' && incoming().status == 'active')
        );
      allow update: if isSignedIn()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == userId
        && (!('uid' in existing()) || incoming().uid == existing().uid)
        && (
          ('email' in existing() && incoming().email == existing().email) ||
          (!('email' in existing()) && (!('email' in request.auth.token) || incoming().email == request.auth.token.email))
        )
        && (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt)
        && (
          ('serverCreatedAt' in existing() && incoming().serverCreatedAt == existing().serverCreatedAt) ||
          (!('serverCreatedAt' in existing()) && (!('serverCreatedAt' in incoming()) || incoming().serverCreatedAt == request.time))
        )
        && incoming().serverUpdatedAt == request.time
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
            'uid', 'email', 'name', 'phone', 'school', 'department', 'className', 'role', 'status',
            'approval_status', 'pilot_group',
            'approvedBy', 'approvedAt', 'createdAt', 'updatedAt', 'serverCreatedAt', 'serverUpdatedAt'
          ])) ||
          (isOwner(userId)
            && existing().status != 'locked'
            && existing().status != 'rejected'
            && incoming().role == existing().role
            && incoming().status == existing().status
            && (!('approval_status' in existing()) ? !('approval_status' in incoming()) : incoming().approval_status == existing().approval_status)
            && (!('pilot_group' in existing()) ? !('pilot_group' in incoming()) : incoming().pilot_group == existing().pilot_group)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'uid', 'email', 'name', 'phone', 'school', 'department', 'className',
              'createdAt', 'updatedAt', 'serverCreatedAt', 'serverUpdatedAt'
            ]))
        );
      allow delete: if isValidId(userId) && isAdmin() && userId != request.auth.uid;
    }

    match /questions/{questionId} {
      allow get: if isValidId(questionId) && (
        (isActiveTeacher() && (
          isOwner(existing().ownerId) ||
          ('isSharedCity' in existing() && existing().isSharedCity == true && 'cityStatus' in existing() && existing().cityStatus == 'approved')
        )) || isAdmin()
      );
      allow list: if isSignedIn() && (
        (isActiveTeacher() && (
          existing().ownerId == request.auth.uid ||
          (existing().isSharedCity == true && existing().cityStatus == 'approved')
        )) || isAdmin()
      );
      allow create: if isValidId(questionId)
        && isValidTeacherQuestion(incoming())
        && incoming().id == questionId
        && incoming().serverCreatedAt == request.time
        && incoming().serverUpdatedAt == request.time
        && (
          (isActiveTeacher()
            && incoming().ownerId == request.auth.uid
            && (!('cityStatus' in incoming()) || incoming().cityStatus == 'pending')) ||
          isAdmin()
        );
      allow update: if isValidId(questionId)
        && isValidTeacherQuestion(incoming())
        && incoming().id == existing().id
        && (
          ('serverCreatedAt' in existing() && incoming().serverCreatedAt == existing().serverCreatedAt) ||
          (!('serverCreatedAt' in existing()) && incoming().serverCreatedAt == request.time)
        )
        && incoming().serverUpdatedAt == request.time
        && (
          (isActiveTeacher()
            && isOwner(existing().ownerId)
            && incoming().ownerId == existing().ownerId
            && (
              !('cityStatus' in incoming()) ||
              incoming().cityStatus == 'pending' ||
              ('cityStatus' in existing() && incoming().cityStatus == existing().cityStatus)
            )
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'code', 'content', 'type', 'subjectId', 'subjectName', 'grade', 'topic',
              'chapterId', 'chapterName', 'lessonId', 'lessonName', 'lessonTopic',
              'level', 'folderId',
              'options', 'correctOptionId', 'correctOptionIds', 'statements', 'shortAnswerConfig',
              'imageUrl', 'explanation', 'source', 'authorName', 'authorSchool', 'parseStatus', 'parseWarning',
              'teacherVerified', 'isSharedCity', 'isPublicCity', 'cityStatus', 'section', 'sectionTitle', 'updatedAt', 'serverCreatedAt', 'serverUpdatedAt'
            ])) ||
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
            'ownerId', 'authorId', 'authorName', 'authorSchool', 'code', 'content', 'type', 'subjectId', 'subjectName',
            'grade', 'topic', 'chapterId', 'chapterName', 'lessonId', 'lessonName', 'lessonTopic',
            'level', 'folderId', 'options', 'correctOptionId', 'correctOptionIds', 'statements',
            'shortAnswerConfig', 'imageUrl', 'explanation', 'source', 'parseStatus',
            'parseWarning', 'teacherVerified', 'isSharedCity', 'isPublicCity', 'cityStatus', 'section', 'sectionTitle',
            'updatedAt', 'serverCreatedAt', 'serverUpdatedAt'
          ]))
        );
      allow delete: if isValidId(questionId) && (
        (isActiveTeacher() && isOwner(existing().ownerId)) || isAdmin()
      );
    }

    match /subjects/{subjectId} {
      allow get: if isValidId(subjectId) && (
        (isActiveTeacher() && isOwner(existing().ownerId)) || isAdmin()
      );
      allow list: if isSignedIn() && (
        (isActiveTeacher() && existing().ownerId == request.auth.uid) || isAdmin()
      );
      allow create: if isValidId(subjectId)
        && isValidTeacherSubject(incoming())
        && incoming().id == subjectId
        && incoming().serverCreatedAt == request.time
        && incoming().serverUpdatedAt == request.time
        && ((isActiveTeacher() && incoming().ownerId == request.auth.uid) || isAdmin());
      allow update: if isValidId(subjectId)
        && isValidTeacherSubject(incoming())
        && incoming().id == existing().id
        && incoming().serverCreatedAt == existing().serverCreatedAt
        && incoming().serverUpdatedAt == request.time
        && (
          (isActiveTeacher()
            && isOwner(existing().ownerId)
            && incoming().ownerId == existing().ownerId
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'shortName', 'codePrefix', 'isDefault', 'order', 'updatedAt', 'serverUpdatedAt'
            ])) ||
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
            'ownerId', 'authorId', 'name', 'shortName', 'codePrefix', 'isDefault', 'order', 'updatedAt', 'serverUpdatedAt'
          ]))
        );
      allow delete: if isValidId(subjectId) && (
        (isActiveTeacher() && isOwner(existing().ownerId)) || isAdmin()
      );
    }

    match /folders/{folderId} {
      allow get: if isValidId(folderId) && (
        (isActiveTeacher() && isOwner(existing().ownerId)) || isAdmin()
      );
      allow list: if isSignedIn() && (
        (isActiveTeacher() && existing().ownerId == request.auth.uid) || isAdmin()
      );
      allow create: if isValidId(folderId)
        && isValidTeacherFolder(incoming())
        && incoming().id == folderId
        && incoming().serverCreatedAt == request.time
        && incoming().serverUpdatedAt == request.time
        && ((isActiveTeacher() && incoming().ownerId == request.auth.uid) || isAdmin());
      allow update: if isValidId(folderId)
        && isValidTeacherFolder(incoming())
        && incoming().id == existing().id
        && (
          ('serverCreatedAt' in existing() && incoming().serverCreatedAt == existing().serverCreatedAt) ||
          (!('serverCreatedAt' in existing()) && incoming().serverCreatedAt == request.time)
        )
        && incoming().serverUpdatedAt == request.time
        && (
          (isActiveTeacher()
            && isOwner(existing().ownerId)
            && incoming().ownerId == existing().ownerId
            && (!('createdBy' in existing()) || incoming().createdBy == existing().createdBy)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'folderId', 'name', 'parentId', 'description', 'grade', 'color', 'authorId',
              'createdBy', 'updatedBy', 'itemCount', 'updatedAt', 'serverCreatedAt', 'serverUpdatedAt'
            ])) ||
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
            'folderId', 'ownerId', 'authorId', 'createdBy', 'updatedBy', 'name', 'parentId',
            'description', 'grade', 'color', 'itemCount', 'updatedAt', 'serverCreatedAt', 'serverUpdatedAt'
          ]))
        );
      allow delete: if isValidId(folderId) && (
        (isActiveTeacher() && isOwner(existing().ownerId)) || isAdmin()
      );
    }

    match /classes/{classId} {
      allow get: if isValidId(classId) && (
        (isActiveTeacher() && isOwner(existing().ownerId)) ||
        isAdmin() ||
        (isActiveStudent() && exists(/databases/$(database)/documents/classEnrollments/$(classId + '_' + request.auth.uid)))
      );
      allow list: if isSignedIn() && (
        (isActiveTeacher() && existing().ownerId == request.auth.uid) || isAdmin()
      );
      allow create: if isValidId(classId)
        && isValidClassroom(incoming())
        && incoming().id == classId
        && incoming().serverCreatedAt == request.time
        && incoming().serverUpdatedAt == request.time
        && ((isActiveTeacher() && incoming().ownerId == request.auth.uid) || isAdmin());
      allow update: if isValidId(classId)
        && isValidClassroom(incoming())
        && incoming().id == existing().id
        && incoming().serverCreatedAt == existing().serverCreatedAt
        && incoming().serverUpdatedAt == request.time
        && (
          (isActiveTeacher()
            && isOwner(existing().ownerId)
            && incoming().ownerId == existing().ownerId
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'teacherName', 'school', 'className', 'classCode', 'description',
              'assignedExamCodes', 'isActive', 'updatedAt', 'serverUpdatedAt'
            ])) ||
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
            'ownerId', 'teacherName', 'school', 'className', 'classCode',
            'description', 'assignedExamCodes', 'isActive', 'updatedAt', 'serverUpdatedAt'
          ]))
        );
      allow delete: if isValidId(classId) && (
        (isActiveTeacher() && isOwner(existing().ownerId)) || isAdmin()
      );
    }

    match /classJoinCodes/{classCode} {
      allow get: if isValidId(classCode) && isValidExamCode(classCode) && isSignedIn();
      allow list: if false;
      allow create: if isValidId(classCode)
        && isValidClassJoinLookup(incoming())
        && incoming().classCode == classCode
        && incoming().serverUpdatedAt == request.time
        && ((isActiveTeacher() && incoming().teacherId == request.auth.uid) || isAdmin());
      allow update: if isValidId(classCode)
        && isValidClassJoinLookup(incoming())
        && incoming().classCode == existing().classCode
        && incoming().serverUpdatedAt == request.time
        && (
          (isActiveTeacher()
            && isOwner(existing().teacherId)
            && incoming().teacherId == existing().teacherId
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'className', 'teacherName', 'school', 'assignedExamCodes',
              'isActive', 'updatedAt', 'serverUpdatedAt'
            ])) ||
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
            'classId', 'className', 'teacherId', 'teacherName', 'school',
            'assignedExamCodes', 'isActive', 'updatedAt', 'serverUpdatedAt'
          ]))
        );
      allow delete: if isValidId(classCode) && (
        (isActiveTeacher() && isOwner(existing().teacherId)) || isAdmin()
      );
    }

    match /classEnrollments/{enrollmentId} {
      allow get: if isValidId(enrollmentId) && isSignedIn() && (
        existing().studentId == request.auth.uid ||
        (isActiveTeacher() && isOwner(existing().teacherId)) ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        existing().studentId == request.auth.uid ||
        (isActiveTeacher() && existing().teacherId == request.auth.uid) ||
        isAdmin()
      );
      allow create: if isValidId(enrollmentId)
        && isValidClassEnrollment(incoming())
        && incoming().id == enrollmentId
        && incoming().serverJoinedAt == request.time
        && (
          isAdmin() ||
          (isActiveTeacher() && incoming().teacherId == request.auth.uid) ||
          (isSignedIn()
            && incoming().studentId == request.auth.uid
            && enrollmentId == (incoming().classId + '_' + request.auth.uid)
            && exists(/databases/$(database)/documents/classJoinCodes/$(incoming().classCode))
            && get(/databases/$(database)/documents/classJoinCodes/$(incoming().classCode)).data.isActive == true
            && get(/databases/$(database)/documents/classJoinCodes/$(incoming().classCode)).data.classId == incoming().classId
            && get(/databases/$(database)/documents/classJoinCodes/$(incoming().classCode)).data.teacherId == incoming().teacherId)
        );
      allow update: if isValidId(enrollmentId)
        && isValidClassEnrollment(incoming())
        && isAdmin()
        && incoming().id == existing().id
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'className', 'teacherName', 'studentName', 'studentClassName'
        ]);
      allow delete: if isValidId(enrollmentId) && isSignedIn() && (
        existing().studentId == request.auth.uid ||
        (isActiveTeacher() && isOwner(existing().teacherId)) ||
        isAdmin()
      );
    }

    match /uploadRecords/{recordId} {
      allow get: if isValidId(recordId) && (
        (isActiveTeacher() && isOwner(existing().ownerId)) || isAdmin()
      );
      allow list: if isSignedIn() && (
        (isActiveTeacher() && existing().ownerId == request.auth.uid) || isAdmin()
      );
      allow create: if isValidId(recordId)
        && isValidUploadRecord(incoming())
        && incoming().id == recordId
        && incoming().serverCreatedAt == request.time
        && ((isActiveTeacher() && incoming().ownerId == request.auth.uid) || isAdmin());
      allow update: if isValidId(recordId)
        && isValidUploadRecord(incoming())
        && isAdmin()
        && incoming().id == existing().id
        && incoming().serverCreatedAt == existing().serverCreatedAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['ownerId']);
      allow delete: if isValidId(recordId) && (
        (isActiveTeacher() && isOwner(existing().ownerId)) || isAdmin()
      );
    }

    match /exams/{examId} {
      allow get: if isValidId(examId) && (
        (isActiveTeacher() && (isOwner(existing().ownerId) || existing().share_status == 'city_public')) || isAdmin()
      );
      allow list: if isSignedIn() && (
        (isActiveTeacher() && (existing().ownerId == request.auth.uid || existing().share_status == 'city_public')) || isAdmin()
      );
      allow create: if isValidId(examId)
        && isValidExamMaster(incoming())
        && incoming().id == examId
        && incoming().serverCreatedAt == request.time
        && incoming().serverUpdatedAt == request.time
        && (
          (isActiveTeacher()
            && incoming().ownerId == request.auth.uid
            && (!('share_status' in incoming()) || incoming().share_status == 'private')
            && !('cityApprovedBy' in incoming())
            && !('cityApprovedAt' in incoming())) ||
          isAdmin()
        );
      allow update: if isValidId(examId)
        && isValidExamMaster(incoming())
        && incoming().id == existing().id
        && (
          ('serverCreatedAt' in existing() && incoming().serverCreatedAt == existing().serverCreatedAt) ||
          (!('serverCreatedAt' in existing()) && incoming().serverCreatedAt == request.time)
        )
        && incoming().serverUpdatedAt == request.time
        && (
          (isActiveTeacher()
            && isOwner(existing().ownerId)
            && incoming().ownerId == existing().ownerId
            && (!('createdBy' in existing()) || incoming().createdBy == existing().createdBy)
            && (!('share_status' in incoming())
              || incoming().share_status in ['private', 'pending_review']
              || ('share_status' in existing() && incoming().share_status == existing().share_status))
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'examId', 'code', 'publicCode', 'title', 'description', 'subjectId', 'subjectName',
              'grade', 'topic', 'folderId', 'durationMinutes',
              'totalQuestions', 'totalScore', 'questions', 'rules',
              'shuffleQuestions', 'shuffleOptions', 'isPublished', 'openAt', 'closeAt',
              'maxAttempts', 'showScoreAfterSubmit', 'showAnswersAfterSubmit',
              'showSolutionsAfterSubmit', 'allowReviewLater', 'assignedClassCodes',
              'requiresPassword', 'passwordUpdatedAt', 'allowAnswerReview',
              'answerReviewMinScore', 'answerReviewEnabledAt',
              'authorSchool', 'authorDepartment', 'share_status', 'shareRequestedAt', 'clonedFromExamId',
              'createdBy', 'updatedBy', 'authorName', 'updatedAt', 'serverCreatedAt', 'serverUpdatedAt'
            ])) ||
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
            'examId', 'ownerId', 'authorId', 'createdBy', 'updatedBy', 'code', 'publicCode', 'title', 'description',
            'subjectId', 'subjectName', 'grade', 'topic', 'folderId',
            'durationMinutes', 'totalQuestions', 'totalScore', 'questions', 'rules',
            'shuffleQuestions', 'shuffleOptions', 'isPublished', 'openAt', 'closeAt',
            'maxAttempts', 'showScoreAfterSubmit', 'showAnswersAfterSubmit',
            'showSolutionsAfterSubmit', 'allowReviewLater', 'assignedClassCodes',
            'requiresPassword', 'passwordUpdatedAt', 'allowAnswerReview',
            'answerReviewMinScore', 'answerReviewEnabledAt',
            'authorName', 'authorSchool', 'authorDepartment',
            'share_status', 'shareRequestedAt', 'cityApprovedBy', 'cityApprovedAt', 'cityReviewNote',
            'clonedFromExamId', 'cloneCount',
            'updatedAt', 'serverCreatedAt', 'serverUpdatedAt'
          ]))
        );
      allow delete: if isValidId(examId) && (
        (isActiveTeacher() && isOwner(existing().ownerId)) || isAdmin()
      );
    }

    match /examStatus/{examCode} {
      allow get: if isValidId(examCode) && isValidExamCode(examCode);
      allow list: if false;
      allow create: if isValidId(examCode)
        && isValidExamStatus(incoming())
        && incoming().examCode == examCode
        && incoming().serverUpdatedAt == request.time
        && ((isActiveTeacher() && incoming().ownerId == request.auth.uid) || isAdmin());
      allow update: if isValidId(examCode)
        && isValidExamStatus(incoming())
        && incoming().examCode == existing().examCode
        && incoming().serverUpdatedAt == request.time
        && (
          (isActiveTeacher()
            && isOwner(existing().ownerId)
            && incoming().ownerId == existing().ownerId
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'examId', 'publicCode', 'title', 'grade', 'durationMinutes', 'totalQuestions',
              'totalScore', 'isPublished', 'openAt', 'closeAt',
              'requiresPassword', 'allowAnswerReview', 'answerReviewMinScore',
              'answerReviewEnabledAt', 'showScoreAfterSubmit', 'showSolutionsAfterSubmit',
              'maxAttempts', 'authorName', 'updatedAt', 'serverUpdatedAt'
            ])) ||
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
            'ownerId', 'examId', 'publicCode', 'title', 'grade', 'durationMinutes', 'totalQuestions',
            'totalScore', 'isPublished', 'openAt', 'closeAt',
            'requiresPassword', 'allowAnswerReview', 'answerReviewMinScore',
            'answerReviewEnabledAt', 'showScoreAfterSubmit', 'showSolutionsAfterSubmit',
            'maxAttempts', 'authorName', 'updatedAt', 'serverUpdatedAt'
          ]))
        );
      allow delete: if isValidId(examCode) && (
        (isActiveTeacher() && isOwner(existing().ownerId)) || isAdmin()
      );
    }

    match /publicExams/{examCode} {
      allow get: if isValidId(examCode) && isValidExamCode(examCode) && (
        (isActiveTeacher() && isOwner(existing().ownerId)) ||
        isAdmin() ||
        (existing().isPublished == true && (
          !('requiresPassword' in existing()) ||
          existing().requiresPassword == false ||
          (isSignedIn() && exists(/databases/$(database)/documents/examAccessGrants/$(examCode + '_' + request.auth.uid)))
        ))
      );
      allow list: if false;
      allow create: if isValidId(examCode)
        && isValidPublicExam(incoming())
        && incoming().code == examCode
        && incoming().serverUpdatedAt == request.time
        && ((isActiveTeacher() && incoming().ownerId == request.auth.uid) || isAdmin());
      allow update: if isValidId(examCode)
        && isValidPublicExam(incoming())
        && incoming().code == existing().code
        && incoming().serverUpdatedAt == request.time
        && (
          (isActiveTeacher()
            && isOwner(existing().ownerId)
            && incoming().ownerId == existing().ownerId
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'id', 'publicCode', 'title', 'grade', 'topic', 'durationMinutes', 'totalQuestions',
              'totalScore', 'questions', 'rules', 'shuffleQuestions', 'shuffleOptions',
              'isPublished', 'openAt', 'closeAt', 'maxAttempts', 'showScoreAfterSubmit',
              'showAnswersAfterSubmit', 'showSolutionsAfterSubmit', 'allowReviewLater',
              'assignedClassCodes', 'requiresPassword', 'passwordUpdatedAt',
              'allowAnswerReview', 'answerReviewMinScore', 'answerReviewEnabledAt',
              'authorName', 'updatedAt', 'serverUpdatedAt'
            ])) ||
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
            'ownerId', 'id', 'publicCode', 'title', 'grade', 'topic', 'durationMinutes', 'totalQuestions',
            'totalScore', 'questions', 'rules', 'shuffleQuestions', 'shuffleOptions',
            'isPublished', 'openAt', 'closeAt', 'maxAttempts', 'showScoreAfterSubmit',
            'showAnswersAfterSubmit', 'showSolutionsAfterSubmit', 'allowReviewLater',
            'assignedClassCodes', 'requiresPassword', 'passwordUpdatedAt',
            'allowAnswerReview', 'answerReviewMinScore', 'answerReviewEnabledAt',
            'authorName', 'updatedAt', 'serverUpdatedAt'
          ]))
        );
      allow delete: if isValidId(examCode) && (
        (isActiveTeacher() && isOwner(existing().ownerId)) || isAdmin()
      );
    }

    match /examLinks/{publicCode} {
      // Public single-doc lookup by exact 6-digit code. Never allow list or client writes.
      allow get: if isValidPublicCode(publicCode);
      allow list, create, update, delete: if false;
    }

    match /examKeys/{examCode} {
      // Strictly teacher owner & admin only. Students NEVER read examKeys directly;
      // they must pass server-side floor-score verification (/api/exams/request-answer-review).
      allow get: if isValidId(examCode) && isValidExamCode(examCode) && (
        (isActiveTeacher() && isOwner(existing().ownerId)) ||
        isAdmin()
      );
      allow list: if false;
      allow create: if isValidId(examCode)
        && isValidExamAnswerKey(incoming())
        && incoming().examCode == examCode
        && incoming().serverUpdatedAt == request.time
        && ((isActiveTeacher() && incoming().ownerId == request.auth.uid) || isAdmin());
      allow update: if isValidId(examCode)
        && isValidExamAnswerKey(incoming())
        && incoming().examCode == existing().examCode
        && incoming().serverUpdatedAt == request.time
        && (
          (isActiveTeacher()
            && isOwner(existing().ownerId)
            && incoming().ownerId == existing().ownerId
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'examId', 'isPublished', 'showAnswersAfterSubmit',
              'showSolutionsAfterSubmit', 'allowAnswerReview', 'answerReviewMinScore',
              'answerReviewEnabledAt', 'answerMap', 'updatedAt', 'serverUpdatedAt'
            ])) ||
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
            'ownerId', 'examId', 'isPublished', 'showAnswersAfterSubmit',
            'showSolutionsAfterSubmit', 'allowAnswerReview', 'answerReviewMinScore',
            'answerReviewEnabledAt', 'answerMap', 'updatedAt', 'serverUpdatedAt'
          ]))
        );
      allow delete: if isValidId(examCode) && (
        (isActiveTeacher() && isOwner(existing().ownerId)) || isAdmin()
      );
    }

    match /examSecrets/{examCode} {
      // Zero client read/list access. Password hashes & server grading keys live here.
      allow get, list: if false;
      allow create: if isValidId(examCode)
        && isValidExamSecret(incoming())
        && incoming().examCode == examCode
        && ((isActiveTeacher() && incoming().ownerId == request.auth.uid) || isAdmin());
      allow update: if isValidId(examCode)
        && isValidExamSecret(incoming())
        && incoming().examCode == existing().examCode
        && ((isActiveTeacher() && isOwner(existing().ownerId) && incoming().ownerId == existing().ownerId) || isAdmin());
      allow delete: if isValidId(examCode) && (
        (isActiveTeacher() && isOwner(existing().ownerId)) || isAdmin()
      );
    }

    match /examPasswordAttempts/{attemptId} {
      allow read, write: if false;
    }

    match /examAccessGrants/{grantId} {
      allow get: if isValidId(grantId) && isSignedIn() && existing().uid == request.auth.uid;
      allow list, create, update, delete: if false;
    }

    match /answerReviewAccess/{accessId} {
      allow get: if isValidId(accessId) && isSignedIn() && existing().uid == request.auth.uid;
      allow list, create, update, delete: if false;
    }

    match /submissions/{submissionId} {
      allow get: if isValidId(submissionId) && (
        (isActiveTeacher() && isOwner(existing().ownerId)) ||
        (isActiveStudent() && existing().studentId == request.auth.uid) ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        (isActiveTeacher() && existing().ownerId == request.auth.uid) ||
        (isActiveStudent() && existing().studentId == request.auth.uid) ||
        isAdmin()
      );
      allow create: if isValidId(submissionId)
        && isValidSubmission(incoming())
        && incoming().id == submissionId
        && incoming().createdAt == request.time
        && (!('gradedByServer' in incoming()) || incoming().gradedByServer == false)
        && !('serverGradeDigest' in incoming())
        && !('serverGradedAt' in incoming())
        && (!isSignedIn() || incoming().studentId == request.auth.uid || isActiveTeacher() || isAdmin())
        && exists(/databases/$(database)/documents/publicExams/$(incoming().examCode))
        && get(/databases/$(database)/documents/publicExams/$(incoming().examCode)).data.isPublished == true
        && incoming().ownerId == get(/databases/$(database)/documents/publicExams/$(incoming().examCode)).data.ownerId
        && (
          !('requiresPassword' in get(/databases/$(database)/documents/publicExams/$(incoming().examCode)).data) ||
          get(/databases/$(database)/documents/publicExams/$(incoming().examCode)).data.requiresPassword == false ||
          (isSignedIn() && exists(/databases/$(database)/documents/examAccessGrants/$(incoming().examCode + '_' + request.auth.uid)))
        );
      allow update: if isValidId(submissionId)
        && isValidSubmission(incoming())
        && (isAdmin() || (isActiveTeacher() && isOwner(existing().ownerId) && existing().status != 'completed'))
        && incoming().id == existing().id
        && incoming().examId == existing().examId
        && incoming().examCode == existing().examCode
        && incoming().createdAt == existing().createdAt
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
            'ownerId', 'part1Score', 'part2Score', 'part3Score', 'totalScore',
            'correctQuestionsCount', 'status'
          ])) ||
          (incoming().ownerId == existing().ownerId && incoming().diff(existing()).affectedKeys().hasOnly([
            'part1Score', 'part2Score', 'part3Score', 'totalScore',
            'correctQuestionsCount', 'status'
          ]))
        );
      allow delete: if isValidId(submissionId) && (
        (isActiveTeacher() && isOwner(existing().ownerId)) || isAdmin()
      );
    }

    match /submissionSnapshots/{submissionId} {
      // Strictly Teacher-owner or Admin only. Students NEVER access teacher answer-key snapshots.
      allow get: if isValidId(submissionId) && (
        (isActiveTeacher() && isOwner(existing().ownerId)) || isAdmin()
      );
      allow list: if isSignedIn() && (
        (isActiveTeacher() && existing().ownerId == request.auth.uid) || isAdmin()
      );
      allow create: if isValidId(submissionId)
        && isValidSubmissionSnapshot(incoming())
        && incoming().id == submissionId
        && incoming().submissionId == submissionId
        && ((isActiveTeacher() && incoming().ownerId == request.auth.uid) || isAdmin());
      allow update: if isValidId(submissionId)
        && isAdmin()
        && isValidSubmissionSnapshot(incoming())
        && incoming().id == existing().id
        && incoming().submissionId == existing().submissionId
        && incoming().diff(existing()).affectedKeys().hasOnly(['ownerId']);
      allow delete: if isValidId(submissionId) && (
        (isActiveTeacher() && isOwner(existing().ownerId)) || isAdmin()
      );
    }

    match /admins/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    function isValidCurriculumConfig(data) {
      return data.keys().hasAll([
          'id', 'textbookSeries', 'textbookYear', 'updatedAt', 'serverUpdatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'textbookSeries', 'textbookYear', 'schoolName', 'updatedBy',
          'updatedAt', 'serverUpdatedAt'
        ])
        && isValidId(data.id)
        && data.textbookSeries is string && data.textbookSeries.size() <= 150
        && data.textbookYear is string && data.textbookYear.size() <= 64
        && (!('schoolName' in data) || (data.schoolName is string && data.schoolName.size() <= 200))
        && (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 128))
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && data.serverUpdatedAt is timestamp;
    }

    function isValidCurriculumLesson(data) {
      return data.keys().hasAll([
          'id', 'subjectId', 'subjectName', 'grade', 'textbookSeries', 'textbookYear',
          'chapterId', 'chapterName', 'lessonId', 'lessonName', 'lessonOrder', 'status',
          'createdAt', 'updatedAt', 'serverCreatedAt', 'serverUpdatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'subjectId', 'subjectName', 'grade', 'textbookSeries', 'textbookYear',
          'chapterId', 'chapterName', 'chapterOrder', 'lessonId', 'lessonName', 'lessonOrder',
          'status', 'createdBy', 'updatedBy', 'createdAt', 'updatedAt',
          'serverCreatedAt', 'serverUpdatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.subjectId)
        && data.subjectName is string && data.subjectName.size() >= 1 && data.subjectName.size() <= 120
        && data.grade in ['10', '11', '12']
        && data.textbookSeries is string && data.textbookSeries.size() >= 1 && data.textbookSeries.size() <= 150
        && data.textbookYear is string && data.textbookYear.size() >= 1 && data.textbookYear.size() <= 64
        && isValidId(data.chapterId)
        && data.chapterName is string && data.chapterName.size() >= 1 && data.chapterName.size() <= 250
        && (!('chapterOrder' in data) || (data.chapterOrder is number && data.chapterOrder >= 0 && data.chapterOrder <= 10000))
        && isValidId(data.lessonId)
        && data.lessonName is string && data.lessonName.size() >= 1 && data.lessonName.size() <= 250
        && data.lessonOrder is number && data.lessonOrder >= 0 && data.lessonOrder <= 10000
        && data.status in ['active', 'inactive']
        && (!('createdBy' in data) || (data.createdBy is string && data.createdBy.size() <= 128))
        && (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 128))
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && data.serverCreatedAt is timestamp
        && data.serverUpdatedAt is timestamp;
    }

    match /curriculumConfig/{configId} {
      allow get: if isValidId(configId) && isSignedIn() && (isActiveTeacher() || isAdmin());
      allow list: if isSignedIn() && (isActiveTeacher() || isAdmin());
      allow create, update: if isValidId(configId)
        && isAdmin()
        && isValidCurriculumConfig(incoming())
        && incoming().id == configId
        && incoming().serverUpdatedAt == request.time;
      allow delete: if isValidId(configId) && isAdmin();
    }

    match /curriculumLessons/{lessonId} {
      allow get: if isValidId(lessonId) && isSignedIn() && (isActiveTeacher() || isAdmin());
      allow list: if isSignedIn() && (isActiveTeacher() || isAdmin());
      allow create: if isValidId(lessonId)
        && isAdmin()
        && isValidCurriculumLesson(incoming())
        && incoming().id == lessonId
        && incoming().serverCreatedAt == request.time
        && incoming().serverUpdatedAt == request.time;
      allow update: if isValidId(lessonId)
        && isAdmin()
        && isValidCurriculumLesson(incoming())
        && incoming().id == existing().id
        && (
          ('serverCreatedAt' in existing() && incoming().serverCreatedAt == existing().serverCreatedAt) ||
          (!('serverCreatedAt' in existing()) && incoming().serverCreatedAt == request.time)
        )
        && incoming().serverUpdatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'subjectId', 'subjectName', 'grade', 'textbookSeries', 'textbookYear',
          'chapterId', 'chapterName', 'chapterOrder', 'lessonId', 'lessonName', 'lessonOrder',
          'status', 'updatedBy', 'updatedAt', 'serverCreatedAt', 'serverUpdatedAt'
        ]);
      allow delete: if isValidId(lessonId) && isAdmin();
    }

    function isValidCurriculumImportLog(data) {
      return data.keys().hasAll([
          'id', 'fileName', 'actorUid', 'actorName', 'importedAt', 'mode',
          'subjectsCount', 'gradesCount', 'chaptersCount', 'lessonsCount',
          'addedCount', 'updatedCount', 'skippedCount', 'deletedCount',
          'errorCount', 'duplicateCount', 'serverCreatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'fileName', 'actorUid', 'actorName', 'actorEmail', 'importedAt', 'mode',
          'subjectsCount', 'gradesCount', 'chaptersCount', 'lessonsCount',
          'addedCount', 'updatedCount', 'skippedCount', 'deletedCount',
          'errorCount', 'duplicateCount', 'textbooks', 'serverCreatedAt'
        ])
        && isValidId(data.id)
        && data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 250
        && isValidId(data.actorUid)
        && data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 150
        && (!('actorEmail' in data) || (data.actorEmail is string && data.actorEmail.size() <= 200))
        && data.importedAt is string && data.importedAt.size() <= 64
        && data.mode in ['append', 'sync']
        && data.subjectsCount is number && data.subjectsCount >= 0 && data.subjectsCount <= 500
        && data.gradesCount is number && data.gradesCount >= 0 && data.gradesCount <= 20
        && data.chaptersCount is number && data.chaptersCount >= 0 && data.chaptersCount <= 10000
        && data.lessonsCount is number && data.lessonsCount >= 0 && data.lessonsCount <= 100000
        && data.addedCount is number && data.addedCount >= 0 && data.addedCount <= 100000
        && data.updatedCount is number && data.updatedCount >= 0 && data.updatedCount <= 100000
        && data.skippedCount is number && data.skippedCount >= 0 && data.skippedCount <= 100000
        && data.deletedCount is number && data.deletedCount >= 0 && data.deletedCount <= 100000
        && data.errorCount is number && data.errorCount >= 0 && data.errorCount <= 100000
        && data.duplicateCount is number && data.duplicateCount >= 0 && data.duplicateCount <= 100000
        && (!('textbooks' in data) || (
          data.textbooks is list
          && data.textbooks.size() <= 20
          && (data.textbooks.size() == 0 || (data.textbooks[0] is string && data.textbooks[0].size() <= 150))
        ))
        && data.serverCreatedAt is timestamp;
    }

    match /curriculumImportLogs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(logId)
        && isAdmin()
        && isValidCurriculumImportLog(incoming())
        && incoming().id == logId
        && incoming().actorUid == request.auth.uid
        && incoming().serverCreatedAt == request.time;
      allow update, delete: if false;
    }
  }
}
