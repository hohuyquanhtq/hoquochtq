      "type": "object",
      "properties": {
        "publicCode": { "type": "string", "minLength": 6, "maxLength": 6, "pattern": "^([0-9]{6}|[A-HJ-NP-Z2-9]{6})$" },
        "examId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "examCode": { "type": "string", "minLength": 2, "maxLength": 32, "pattern": "^[A-Z0-9\\-]+$" },
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["publicCode", "examId", "examCode", "ownerId", "isActive", "createdAt", "updatedAt"]
    },
    "TeacherSubject": {
      "title": "TeacherSubject",
      "description": "Teacher-created custom subject extending the GDPT 2018 subject catalog.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "shortName": { "type": "string", "maxLength": 40 },
        "codePrefix": { "type": "string", "maxLength": 16 },
        "isDefault": { "type": "boolean" },
        "order": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "name", "createdAt", "updatedAt"]
    },
    "CurriculumConfig": {
      "title": "CurriculumConfig",
      "description": "School-wide approved GDPT 2018 textbook series configuration managed by Admin.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "textbookSeries": { "type": "string", "maxLength": 150 },
        "textbookYear": { "type": "string", "maxLength": 64 },
        "schoolName": { "type": "string", "maxLength": 200 },
        "updatedBy": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "textbookSeries", "textbookYear", "updatedAt"]
    },
    "CurriculumLesson": {
      "title": "CurriculumLesson",
      "description": "Admin-curated GDPT 2018 textbook chapter and lesson entry indexed by subjectId and grade.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "subjectId": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "subjectName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "grade": { "type": "string", "enum": ["10", "11", "12"] },
        "textbookSeries": { "type": "string", "minLength": 1, "maxLength": 150 },
        "textbookYear": { "type": "string", "minLength": 1, "maxLength": 64 },
        "chapterId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "chapterName": { "type": "string", "minLength": 1, "maxLength": 250 },
        "chapterOrder": { "type": "number" },
        "lessonId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "lessonName": { "type": "string", "minLength": 1, "maxLength": 250 },
        "lessonOrder": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "createdBy": { "type": "string", "maxLength": 128 },
        "updatedBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "subjectId", "subjectName", "grade", "textbookSeries", "textbookYear",
        "chapterId", "chapterName", "lessonId", "lessonName", "lessonOrder", "status",
        "createdAt", "updatedAt"
      ]
    },
    "CurriculumImportLog": {
      "title": "CurriculumImportLog",
      "description": "Immutable admin audit log for Excel/CSV curriculum bulk imports.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fileName": { "type": "string", "minLength": 1, "maxLength": 250 },
        "actorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "actorName": { "type": "string", "minLength": 1, "maxLength": 150 },
        "actorEmail": { "type": "string", "maxLength": 200 },
        "importedAt": { "type": "string", "format": "date-time" },
        "mode": { "type": "string", "enum": ["append", "sync"] },
        "subjectsCount": { "type": "number" },
        "gradesCount": { "type": "number" },
        "chaptersCount": { "type": "number" },
        "lessonsCount": { "type": "number" },
        "addedCount": { "type": "number" },
        "updatedCount": { "type": "number" },
        "skippedCount": { "type": "number" },
        "deletedCount": { "type": "number" },
        "errorCount": { "type": "number" },
        "duplicateCount": { "type": "number" },
        "textbooks": { "type": "array" }
      },
      "required": [
        "id", "fileName", "actorUid", "actorName", "importedAt", "mode",
        "subjectsCount", "gradesCount", "chaptersCount", "lessonsCount",
        "addedCount", "updatedCount", "skippedCount", "deletedCount",
        "errorCount", "duplicateCount"
      ]
    },
    "AdminQuestionAuditLog": {
      "title": "AdminQuestionAuditLog",
      "description": "Immutable Admin-only audit record for copying, editing, or deleting teacher questions from the school-wide question bank.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "action": { "type": "string", "enum": ["copy_to_admin", "edit_original", "delete_original"] },
        "questionId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "questionCode": { "type": "string", "maxLength": 64 },
        "copiedQuestionId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "originalOwnerId": { "type": "string", "maxLength": 128 },
        "originalOwnerName": { "type": "string", "maxLength": 150 },
        "originalOwnerEmail": { "type": "string", "maxLength": 200 },
        "actorUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "actorName": { "type": "string", "minLength": 1, "maxLength": 150 },
        "actorEmail": { "type": "string", "maxLength": 200 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "beforeSummary": { "type": "string", "maxLength": 2000 },
        "afterSummary": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "action", "questionId", "questionCode", "originalOwnerId",
        "originalOwnerName", "actorUid", "actorName", "reason", "beforeSummary", "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profiles with admin-approved teacher status and non-escalatable role."
    },
    "/questions/{questionId}": {
      "schema": { "$ref": "#/entities/TeacherQuestion" },
      "description": "Teacher-isolated Chemistry question bank documents."
    },
    "/folders/{folderId}": {
      "schema": { "$ref": "#/entities/TeacherFolder" },
      "description": "Teacher-isolated folder hierarchy documents."
    },
    "/subjects/{subjectId}": {
      "schema": { "$ref": "#/entities/TeacherSubject" },
      "description": "Teacher-isolated custom GDPT 2018 subject extensions."
    },
    "/classes/{classId}": {
      "schema": { "$ref": "#/entities/Classroom" },
      "description": "Teacher-owned classrooms with join codes and assigned exam codes."
    },
    "/classJoinCodes/{classCode}": {
      "schema": { "$ref": "#/entities/ClassJoinLookup" },
      "description": "Single-doc lookup by classCode for authenticated student enrollment."
    },
    "/classEnrollments/{enrollmentId}": {
      "schema": { "$ref": "#/entities/ClassEnrollment" },
      "description": "Enrollment links keyed by {classId}_{studentUid}."
    },
    "/uploadRecords/{recordId}": {
      "schema": { "$ref": "#/entities/TeacherUploadRecord" },
      "description": "Teacher-isolated DOCX/PDF upload history records."
    },
    "/exams/{examId}": {
      "schema": { "$ref": "#/entities/ExamMaster" },
      "description": "Private teacher-owned master exams with answer keys and explanations."
    },
    "/examStatus/{examCode}": {
      "schema": { "$ref": "#/entities/ExamStatus" },
      "description": "Public single-doc status lookup by exam code without question or answer payloads."
    },
    "/publicExams/{examCode}": {
      "schema": { "$ref": "#/entities/PublicExam" },
      "description": "Sanitized published exam questions readable via single-doc get by exam code."
    },
    "/examLinks/{publicCode}": {
      "schema": { "$ref": "#/entities/ExamLink" },
      "description": "Server-managed 6-digit public link lookup docs (single-doc get only; zero client list or write)."
    },
    "/examKeys/{examCode}": {
      "schema": { "$ref": "#/entities/ExamAnswerKey" },
      "description": "Teacher/Admin-only answer keys. Students must request floor-score-gated review via backend API."
    },
    "/submissions/{submissionId}": {
      "schema": { "$ref": "#/entities/StudentSubmission" },
      "description": "Student exam submissions readable by exam owner teacher, submitting student, or admin."
    },
    "/submissionSnapshots/{submissionId}": {
      "schema": { "$ref": "#/entities/SubmissionSnapshot" },
      "description": "Teacher-owner and Admin-only immutable per-attempt question/answer/key snapshots. Students have zero access."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminMarker" },
      "description": "Admin role assignment documents."
    },
    "/examSecrets/{examCode}": {
      "description": "Server-private vault containing scrypt password hash, server grading rules, and answer keys (client read: false)."
    },
    "/examPasswordAttempts/{attemptId}": {
      "description": "Server-only brute-force attempt counters and lockout windows (client read/write: false)."
    },
    "/examAccessGrants/{grantId}": {
      "description": "Server-issued per-student-per-exam unlock grants keyed by {examCode}_{uid} (client write: false)."
    },
    "/answerReviewAccess/{accessId}": {
      "description": "Server-verified floor-score qualification audit grants keyed by {examCode}_{uid} (client write: false)."
    },
    "/curriculumConfig/{configId}": {
      "schema": { "$ref": "#/entities/CurriculumConfig" },
      "description": "Centralized school textbook series setting managed by Admin and readable by authenticated teachers."
    },
    "/curriculumLessons/{lessonId}": {
      "schema": { "$ref": "#/entities/CurriculumLesson" },
      "description": "Centralized GDPT 2018 chapter/lesson catalog managed by Admin and consumed by Teachers via cascading dropdown."
    },
    "/curriculumImportLogs/{logId}": {
      "schema": { "$ref": "#/entities/CurriculumImportLog" },
      "description": "Admin-only immutable audit history of Excel/CSV bulk curriculum imports."
    },
    "/adminQuestionAuditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AdminQuestionAuditLog" },
      "description": "Admin-only immutable audit log for privileged Super Admin actions on school-wide question bank records."
    }
  }
}
