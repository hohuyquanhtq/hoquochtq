# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_PUBLIC_APP_URL: Optional canonical production domain for exam share links & QR codes
# (e.g. https://hoquochtq.vercel.app). On Vercel builds, VERCEL_PROJECT_PRODUCTION_URL is used automatically.
VITE_PUBLIC_APP_URL=""

# Optional Firebase Web SDK overrides (by default, firebase-applet-config.json is bundled).
# Set these on Vercel Production/Preview only if overriding the bundled Firebase project.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""

# Shared HTQ Chemistry Hub Firestore (dbHub - Project: long-factor-lk4jk)
# Used to share hub_classes and hub_learning_profiles across HQTest and HTQ Hub.
VITE_HUB_FIREBASE_PROJECT_ID="long-factor-lk4jk"
VITE_HUB_FIREBASE_API_KEY=""
VITE_HUB_FIREBASE_AUTH_DOMAIN="long-factor-lk4jk.firebaseapp.com"
VITE_HUB_FIREBASE_STORAGE_BUCKET="long-factor-lk4jk.firebasestorage.app"
VITE_HUB_FIREBASE_MESSAGING_SENDER_ID=""
VITE_HUB_FIREBASE_APP_ID=""
VITE_HUB_FIREBASE_DATABASE_ID=""

# Backend Server Security (Vercel Environment Variables / Server Secrets ONLY - never prefix with VITE_)
# JSON string of Firebase Service Account key (project: hqtest-online) for Admin Custom Claims & server-side security
FIREBASE_SERVICE_ACCOUNT=""
# Initial Admin UID authorized to receive { admin: true, role: "admin" } custom claims via /api/admin/set-claims
INITIAL_ADMIN_UID=""
# Legacy alias supported for server-side exam password verification, grading & answer release
FIREBASE_SERVICE_ACCOUNT_JSON=""
# Alternative split Firebase Admin SDK env vars (if not using JSON string above)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
# Secret key for signing short-lived exam unlock tokens and server-grade integrity digests (min 32 random chars)
EXAM_ACCESS_TOKEN_SECRET=""

